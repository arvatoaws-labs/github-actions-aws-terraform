{
  "extends": [
    "config:recommended"
  ],
  "prFooter": "This PR was generated by Renovate. You can now add the following comments:\n* `/plan` - to run the plan and see the changes that will be applied\n* `/apply` - to apply the changes",
  "enabledManagers": ["terraform", "github-actions"],
  "additionalBranchPrefix": "{{{replace '^([^/]+)/.*$' '$1' packageFile}}}-",
  "commitMessageSuffix": "({{{replace '^([^/]+)/.*$' '$1' packageFile}}})",
  "rebaseWhen": "behind-base-branch",
  "ignorePaths": ["modules/**"],
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "matchManagers": ["terraform"],
      "addLabels": ["terraform-{{{replace '^([^/]+)/.*$' '$1' packageFile}}}-changed", "terraform-changed", "terraform-autoapply-allowed","minor-arvatoaws"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "grouped minor/patch updates - arvatoaws",
      "groupSlug": "arvatoaws",
      "matchPackageNames": [
        "arvatoaws/{/,}**"
      ]
    },
    {
      "matchManagers": ["terraform"],
      "addLabels": ["terraform-{{{replace '^([^/]+)/.*$' '$1' packageFile}}}-changed", "terraform-changed", "minor-aws-modules"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "grouped minor/patch updates - aws-modules",
      "groupSlug": "aws-modules",
      "matchPackageNames": [
        "terraform-aws-modules/{/,}**"
      ]
    },
    {
      "matchManagers": ["terraform"],
      "addLabels": ["terraform-{{{replace '^([^/]+)/.*$' '$1' packageFile}}}-changed", "terraform-changed", "minor-other"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "grouped minor/patch updates - other",
      "groupSlug": "all-other-patches",
      "matchPackageNames": [
        "!arvatoaws{/,}**",
        "!terraform-aws-modules{/,}**"
      ]
    },
    {
      "matchManagers": ["terraform"],
      "addLabels": ["terraform-{{{replace '^([^/]+)/.*$' '$1' packageFile}}}-changed", "terraform-changed", "major"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "!arvatoaws{/,}**",
        "!terraform-aws-modules{/,}**"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["minor-arvatoaws"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "grouped minor/patch updates - arvatoaws terraform github-actions",
      "groupSlug": "github-actions-arvatoaws-terraform",
      "matchPackageNames": [
        "arvatoaws-labs/github-actions-aws-terraform/{/,}**"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["minor-arvatoaws"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "grouped minor/patch updates - arvatoaws github-actions",
      "groupSlug": "github-actions-arvatoaws",
      "matchPackageNames": [
        "arvatoaws/{/,}**",
        "arvatoaws-labs/{/,}**"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": [
        "github-actions-changed",
        "minor"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "grouped minor/patch updates - github-actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": [
        "github-actions-changed",
        "major"
      ],
      "matchUpdateTypes": ["major"]
    }
  ]
}
